# --- Frontend (Next.js) -------------------------------------------------------
# FastAPI statistics engine. When unreachable, the app falls back to the
# on-device TypeScript engine automatically.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional Supabase project for cloud-synced experiment history.
# Leave blank to keep the archive local to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sub-path when hosting under a repository page (set by `npm run predeploy`).
NEXT_PUBLIC_BASE_PATH=

# --- Backend (FastAPI) --------------------------------------------------------
# Comma-separated list of origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000,https://joelraj18.github.io
