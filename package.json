{
  "name": "ab-experimentation-engine",
  "version": "3.0.0",
  "private": true,
  "description": "Apple-grade A/B experimentation engine: sample-size planning, exact frequentist inference, CUPED variance reduction and an experiment archive.",
  "homepage": "https://joelraj18.github.io/A-B-Statistical-Analysis",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
